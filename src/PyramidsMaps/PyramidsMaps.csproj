<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <!-- Which mod to build: Statues (default; PyramidsMaps.dll) or Pyramids (More Pyramids; PyramidsMorePyramids.dll).
         dotnet build -c Release -p:Pack=Pyramids. Both come from this same code; see Packs.cs. -->
    <Pack Condition="'$(Pack)' == ''">Statues</Pack>
    <AssemblyName Condition="'$(Pack)' == 'Pyramids'">PyramidsMorePyramids</AssemblyName>
    <AssemblyName Condition="'$(Pack)' != 'Pyramids'">PyramidsMaps</AssemblyName>
    <DefineConstants Condition="'$(Pack)' == 'Pyramids'">$(DefineConstants);PACK_PYRAMIDS</DefineConstants>
    <PluginFolder>$(AssemblyName)</PluginFolder>
    <OutputPath>bin\$(Configuration)\$(Pack)\</OutputPath>
    <IntermediateOutputPath>obj\$(Configuration)\$(Pack)\</IntermediateOutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!-- Keep in step with Plugin.Version. -->
    <Version>0.7.0</Version>
    <RootNamespace>PyramidsMaps</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <!-- Override on the command line: dotnet build -p:GamePath="..." -->
    <GamePath Condition="'$(GamePath)' == ''">C:\Program Files (x86)\Steam\steamapps\common\How They Built the Pyramids</GamePath>
    <Managed>$(GamePath)\Pyramid_Data\Managed</Managed>
    <BepInExCore>$(GamePath)\BepInEx\core</BepInExCore>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="BepInEx" HintPath="$(BepInExCore)\BepInEx.dll" Private="false" />
    <Reference Include="0Harmony" HintPath="$(BepInExCore)\0Harmony.dll" Private="false" />
    <Reference Include="UnityEngine" HintPath="$(Managed)\UnityEngine.dll" Private="false" />
    <Reference Include="UnityEngine.CoreModule" HintPath="$(Managed)\UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="UnityEngine.PhysicsModule" HintPath="$(Managed)\UnityEngine.PhysicsModule.dll" Private="false" />
    <Reference Include="UnityEngine.TerrainModule" HintPath="$(Managed)\UnityEngine.TerrainModule.dll" Private="false" />
    <Reference Include="UnityEngine.TerrainPhysicsModule" HintPath="$(Managed)\UnityEngine.TerrainPhysicsModule.dll" Private="false" />
    <Reference Include="Assembly-CSharp" HintPath="$(Managed)\Assembly-CSharp.dll" Private="false" />
    <Reference Include="FishNet.Runtime" HintPath="$(Managed)\FishNet.Runtime.dll" Private="false" />
    <Reference Include="Unity.InputSystem" HintPath="$(Managed)\Unity.InputSystem.dll" Private="false" />
    <Reference Include="UnityEngine.UI" HintPath="$(Managed)\UnityEngine.UI.dll" Private="false" />
    <Reference Include="UnityEngine.UIModule" HintPath="$(Managed)\UnityEngine.UIModule.dll" Private="false" />
    <Reference Include="UnityEngine.InputLegacyModule" HintPath="$(Managed)\UnityEngine.InputLegacyModule.dll" Private="false" />
    <Reference Include="Unity.TextMeshPro" HintPath="$(Managed)\Unity.TextMeshPro.dll" Private="false" />
    <Reference Include="UnityEngine.ScreenCaptureModule" HintPath="$(Managed)\UnityEngine.ScreenCaptureModule.dll" Private="false" />
  </ItemGroup>

  <!-- Copy the built plugin into the game's BepInEx\plugins folder. -->
  <Target Name="DeployToGame" AfterTargets="Build" Condition="'$(Deploy)' != 'false'">
    <MakeDir Directories="$(GamePath)\BepInEx\plugins\$(PluginFolder)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(GamePath)\BepInEx\plugins\$(PluginFolder)" />
  </Target>

</Project>
